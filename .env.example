# Copia este archivo como ".env" y completa los valores. NO subas ".env" a Git.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Opcional: clave de Google Directions para dibujar la ruta real.
# Sin ella, la app dibuja una línea recta entre los puntos.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# URL HTTPS pública del backend de solicitudes de retiro
EXPO_PUBLIC_WITHDRAWAL_API_URL=https://TU-BACKEND.com
